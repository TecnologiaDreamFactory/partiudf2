// Banco: Postgres no Supabase. Client gerado em src/generated/prisma (fora do node_modules).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DRIVER
  PASSENGER
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  role      UserRole
  name      String?
  avatarUrl String?
  /// Inativo nao entra nem dirige; as viagens dele ficam no relatorio (no lugar de excluir).
  active    Boolean   @default(true)
  /// Motorista criado/com senha redefinida pelo admin troca a senha no proximo login.
  mustChangePassword Boolean @default(false)
  /// Excluido pelo admin: some do sistema, mas as viagens dele ficam no relatorio.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  trips     Trip[]
  checkins  Checkin[]
}

model PickupPoint {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  lat       Float
  lng       Float
  address   String?
  createdAt DateTime  @default(now())
  checkins  Checkin[]
}

enum CheckinStatus {
  ACTIVE
  CANCELED
}

model Checkin {
  id            String        @id @default(cuid())
  tripId        String
  userId        String
  pickupPointId String
  status        CheckinStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  trip          Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pickupPoint   PickupPoint   @relation(fields: [pickupPointId], references: [id], onDelete: Restrict)

  @@unique([tripId, userId])
}

enum TripStatus {
  ACTIVE
  ENDED
}

model Trip {
  id        String     @id @default(cuid())
  driverId  String
  status    TripStatus
  startedAt DateTime
  endedAt   DateTime?
  driver    User       @relation(fields: [driverId], references: [id])
  checkins  Checkin[]
  viewers   TripViewer[]

  // Ultima posicao da van. Antes ficava na memoria do servidor Nest;
  // no serverless (Vercel) a memoria nao sobrevive entre requisicoes.
  lastLat        Float?
  lastLng        Float?
  lastAccuracy   Float?
  lastSpeed      Float?
  lastHeading    Float?
  lastLocationAt DateTime?

  @@index([status, startedAt])
}

/// Quem acompanhou a viagem no /p. Passageiro nao tem login: visitorId e um UUID
/// aleatorio guardado no navegador (um por aparelho), sem dado pessoal.
model TripViewer {
  tripId      String
  visitorId   String   @db.Uuid
  firstSeenAt DateTime @default(now())
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@id([tripId, visitorId])
  @@index([visitorId])
}
