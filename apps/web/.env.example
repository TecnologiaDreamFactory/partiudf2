# Copie para apps/web/.env.local (dev) ou cadastre na Vercel (producao).
# Valores de dev: `npx supabase start` na raiz e `npx supabase status` mostram as chaves locais.

# --- Banco (Supabase Postgres) ---
# Producao: Supabase > Connect > "Transaction pooler" (porta 6543) — o app roda em serverless.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Producao: "Direct connection" ou "Session pooler" (porta 5432) — usada so pelas migrations.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# --- Login do app (JWT proprio) ---
# Gere uma chave forte: openssl rand -base64 32
JWT_SECRET=troque-por-uma-chave-secreta-forte

# --- Supabase Realtime (posicao da van e check-ins ao vivo) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# Chave publica (publishable/anon): o navegador so OUVE os canais.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (secret/service_role): so no servidor, nunca com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# true = mostra check-in no passageiro; omitir ou false = so acompanhar a van
# NEXT_PUBLIC_PASSENGER_CHECKIN_ENABLED=true

# --- Seed (pnpm --filter @partiudf/web db:seed) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=12345678
